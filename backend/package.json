{
  "name": "backend",
  "version": "1.1.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "index.js",
  "scripts": {
    "postinstall": "npx prisma generate",
    "render-build": "npm install && npx prisma generate && npx prisma migrate deploy",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "snapshot": "node scripts/snapshot.js take",
    "snapshot:list": "node scripts/snapshot.js list",
    "snapshot:info": "node scripts/snapshot.js info",
    "snapshot:restore": "node scripts/snapshot.js restore",
    "snapshot:restore:dry": "node scripts/snapshot.js restore --latest --dry-run",
    "pre:deploy": "node scripts/snapshot.js take --label=pre-deploy && node scripts/pre-deploy-check.js",
    "generate": "prisma generate",
    "test": "jest",
    "test:security": "jest tests/security"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.13.4",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "form-data": "^4.0.5",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.18.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "supertest": "^7.2.2"
  }
}

# --------------------------------------------------------------------
# .env.example — Required environment variables for incident-system
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.
# --------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=3000

# Database (Supabase / PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

# JWT Secret — use a long random string in production
JWT_SECRET=your-very-long-random-secret-here

# Admin Email — this email auto-creates the admin account on first login
ADMIN_EMAIL=admin@yourcompany.com

# Frontend URL — used for CORS and CSRF validation in production
FRONTEND_URL=https://your-frontend-domain.com

# Email (SMTP) — for sending OTP codes
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@yourcompany.com

# Optional: Render/self-ping URL for keep-alive
RENDER_EXTERNAL_URL=https://your-api-url.onrender.com

# QA Agent Configuration
QA_ADMIN_TOKEN=your-admin-jwt-token-for-testing
QA_NOTIFY_EMAIL=admin@yourcompany.com
QA_BASE_URL=http://localhost:3000
QA_FRONTEND_URL=https://your-frontend-domain.com

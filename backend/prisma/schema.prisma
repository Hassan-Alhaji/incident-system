generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String                @id @default(uuid())
  email           String                @unique
  password        String?
  name            String
  firstName       String?
  fatherName      String?
  lastName        String?
  department      String?
  isProfileCompleted Boolean            @default(false)
  role            Role                  @default(OC_REPORTER)
  userGroup       String                @default("OFF_CIRCUIT")
  isIntakeEnabled Boolean               @default(false)
  marshalId       String?               @unique
  mobile          String?
  status          UserStatus            @default(ACTIVE)
  
  // Permissions
  canCloseTickets             Boolean   @default(false)
  canPerformRCA               Boolean   @default(false)
  canEscalate                 Boolean   @default(false)
  canManageUsers              Boolean   @default(false)
  canManageEvents             Boolean   @default(false)
  canManageServiceProviders   Boolean   @default(false)
  canViewAnalytics            Boolean   @default(false)

  otpCode         String?
  otpExpires      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  activityLogs    ActivityLog[]
  notifications   Notification[]
  assignedTickets Ticket[]              @relation("AssignedTickets")
  createdTickets  Ticket[]              @relation("CreatedTickets")
  reminders       Reminder[]

  // Department Relations
  managedDepartment  Department? @relation("DepartmentManager")
  repDepartmentId    String?
  repDepartment      Department? @relation("DepartmentReps", fields: [repDepartmentId], references: [id])

  // Service Provider Relation
  serviceProviderId  String?
  serviceProvider    ServiceProvider? @relation("ServiceProviderReps", fields: [serviceProviderId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  type      String
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([read])
}

model Ticket {
  id                  String               @id @default(uuid())
  ticketNo            String               @unique
  type                TicketType
  status              TicketStatus         @default(SUBMITTED)
  priority            Priority             @default(MEDIUM)
  escalatedToRole     String?
  userGroup           String               @default("OFF_CIRCUIT")
  reporterName        String?
  incidentDate        DateTime?
  incidentTime        String?
  location            String?
  description         String
  createdById         String?
  assignedToId        String?
  closureReason       String?
  closedBy            String?
  closedByRole        String?
  closedAt            DateTime?
  hasInjury           Boolean              @default(false)
  hasFinancialViolation Boolean?
  violationDescription  String?
  violationAmount       String?
  forwardedToFinance    Boolean              @default(false)
  dueDate             DateTime?
  severityLevel       String?              // MAJOR, SIGNIFICANT, MINOR
  serviceProviderId   String?
  departmentId        String?
  department          Department?          @relation("TicketDepartment", fields: [departmentId], references: [id])
  eventId             String?
  event               Event?               @relation("TicketEvent", fields: [eventId], references: [id])
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  activityLogs        ActivityLog[]
  attachments         Attachment[]
  offCircuitReport    OffCircuitReport?
  actionPlans         ActionPlan[]
  reminders           Reminder[]
  assignedTo          User?                @relation("AssignedTickets", fields: [assignedToId], references: [id])
  createdBy           User?                @relation("CreatedTickets", fields: [createdById], references: [id])
  ticketExports       TicketExport[]
  serviceProvider     ServiceProvider?     @relation(fields: [serviceProviderId], references: [id])
  zoneId              String?
  zone                Zone?                @relation(fields: [zoneId], references: [id])

  @@index([status])
  @@index([userGroup])
  @@index([createdById])
  @@index([assignedToId])
  @@index([departmentId])
  @@index([serviceProviderId])
  @@index([zoneId])
  @@index([createdAt])
}

model Zone {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  coordinates Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tickets     Ticket[]
}

model Attachment {
  id        String   @id @default(uuid())
  ticketId  String
  url       String
  type      String
  name      String
  size      Int
  mimeType  String
  refId     String?
  data      Bytes?
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
}

model ActivityLog {
  id        String   @id @default(uuid())
  ticketId  String
  actorId   String?
  action    String
  details   String?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id])
  ticket    Ticket   @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@index([actorId])
}

model OffCircuitReport {
  id                      String   @id @default(uuid())
  ticketId                String   @unique

  // === Reporter Section ===
  incidentType            String?    // OBSERVATION, ACCIDENT, SECURITY
  incidentDate            DateTime?
  incidentTime            String?
  locationLat             Float?
  locationLng             Float?
  locationAddress         String?
  locationDescription     String?    // Free text description of location
  whatHappened             String?
  hasInjury               Boolean    @default(false)

  // Late Reporting (>24h rule)
  isLateReport            Boolean    @default(false)
  lateReportReason        String?

  // Injured Person(s) - JSON array [{name, mobile, type, dept, company}]
  // type: EMPLOYEE | CONTRACTOR | OTHER
  // If EMPLOYEE: name, mobile, dept
  // If CONTRACTOR: name, mobile, company
  injuredPersons          String?

  // Witnesses - JSON array [{name, mobile}]
  witnesses               String?

  reporterFilledBy        String?
  reporterFilledAt        DateTime?

  // === Controller Stage ===
  // Type change tracking
  originalType            String?    // Original type before controller changed it
  typeChangeReason        String?    // Reason for changing the type
  
  // Severity set by controller
  severity                String?    // MAJOR, SIGNIFICANT, MINOR
  hazardCategory          String?    // Biological, Chemical, Physical, Safety, Ergonomic, Psychosocial
  
  // Controller notes
  controllerNotes         String?
  controllerFilledBy      String?
  controllerFilledAt      DateTime?

  // === Department Stage ===
  // GOSI (for employee injuries → HR)
  gosiEmployeeId          String?
  gosiSubmitted           Boolean?   // Did you submit GOSI?
  gosiReportDate          DateTime?  // If yes: date
  gosiReportNumber        String?    // If yes: number
  gosiNoReason            String?    // If no: reason

  // Contractor notification
  contractorNotified      Boolean?   // Was contractor company notified?
  contractorNotifyDate    DateTime?  // If yes: date
  contractorNoReason      String?    // If no: reason

  depRepFilledBy          String?
  depRepFilledAt          DateTime?

  // === HR Stage (GOSI - auto-assigned when employee injured) ===
  hrAssignedAt            DateTime?  // When HR was notified
  hrFilledBy              String?    // HR rep who submitted
  hrFilledAt              DateTime?  // When HR submitted
  hrNotes                 String?    // Notes from HR to HSE
  responsibleDeptId       String?    // The dept the controller routes to AFTER HR completes

  // === RCA Section (Required for all types EXCEPT Observation) ===
  rcaRequired             Boolean    @default(false)
  rcaCompleted            Boolean    @default(false)
  rcaCause                String?    // Q1: Immediate Causes / الأسباب المباشرة
  rcaWhy                  String?    // Q2: Underlying Causes / الأسباب الغير مباشرة
  rcaRootCause            String?    // Q3: Root Causes / الأسباب الجذرية
  rcaCategory             String?    // Q4: Corrective Actions / الإجراءات التصحيحية (repurposed)
  rcaPreventiveActions    String?    // Q5: Preventive Actions / الإجراءات الوقائية
  rcaPreventable          Boolean?   // Legacy field (kept for backward compat)

  rcaFilledBy             String?
  rcaFilledAt             DateTime?

  // === HSE Manager / Safety Manager Final ===
  finalDecision           String?    // CLOSE, REJECT
  finalNotes              String?

  hseManagerFilledBy      String?
  hseManagerFilledAt      DateTime?
  hseManagerSignature     String?

  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
  ticket                  Ticket     @relation(fields: [ticketId], references: [id])
}

// Action Plans submitted by departments
model ActionPlan {
  id              String               @id @default(uuid())
  ticketId        String
  type            ActionPlanType       // IMMEDIATE, SHORT_TERM, LONG_TERM
  description     String
  targetDate      DateTime?
  departmentId    String?
  department      Department?          @relation(fields: [departmentId], references: [id])
  submittedBy     String?
  submittedAt     DateTime?
  status          ActionPlanStatus     @default(PENDING)
  reviewNotes     String?              // Controller review notes
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  ticket          Ticket               @relation(fields: [ticketId], references: [id])
  attachments     ActionPlanAttachment[]

  @@index([ticketId])
  @@index([departmentId])
  @@index([status])
}

// Evidence attachments for Action Plans
model ActionPlanAttachment {
  id              String       @id @default(uuid())
  actionPlanId    String
  url             String
  name            String
  type            String       // IMAGE, DOCUMENT, EMAIL
  size            Int
  mimeType        String
  data            Bytes?
  createdAt       DateTime     @default(now())
  actionPlan      ActionPlan   @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)

  @@index([actionPlanId])
}

// Reminders for pending actions
model Reminder {
  id              String       @id @default(uuid())
  ticketId        String
  message         String
  reminderDate    DateTime
  isCompleted     Boolean      @default(false)
  completedAt     DateTime?
  completedNote   String?
  createdById     String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  ticket          Ticket       @relation(fields: [ticketId], references: [id])
  createdBy       User         @relation(fields: [createdById], references: [id])

  @@index([ticketId])
}

model Department {
  id              String             @id @default(uuid())
  name            String             @unique
  nameAr          String?            
  managerId       String?            @unique
  manager         User?              @relation("DepartmentManager", fields: [managerId], references: [id])
  representatives User[]             @relation("DepartmentReps")
  serviceProviders ServiceProvider[]
  tickets         Ticket[]           @relation("TicketDepartment")
  actionPlans     ActionPlan[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model ServiceProvider {
  id                           String     @id @default(uuid())
  name                         String     // English name (legacy primary)
  nameAr                       String?    // Arabic name
  commercialRegistrationNumber String     @unique
  // Primary representative contact (denormalised for forms/reports)
  representativeName           String?
  representativeEmail          String?
  representativeMobile         String?
  status                       String     @default("ACTIVE")
  responsibleDepartmentId      String
  department                   Department @relation(fields: [responsibleDepartmentId], references: [id])
  representatives              User[]     @relation("ServiceProviderReps")
  tickets                      Ticket[]
  createdAt                    DateTime   @default(now())
  updatedAt                    DateTime   @updatedAt
}

model TicketExport {
  id           String   @id @default(uuid())
  ticketId     String
  verifyToken  String   @unique
  version      Int      @default(1)
  snapshotJson String?
  pdfUrl       String
  generatedBy  String?
  createdAt    DateTime @default(now())
  ticket       Ticket   @relation(fields: [ticketId], references: [id])
}

model Event {
  id        String   @id @default(uuid())
  nameEn    String
  nameAr    String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets   Ticket[] @relation("TicketEvent")
}

// ==================== ENUMS ====================

enum Role {
  ADMIN
  
  // Core Roles for Incident System
  OC_REPORTER         // Creates incident reports
  HSE_CONTROLLER      // Reviews, classifies, routes tickets
  DEP_REP             // Department representative - submits action plans
  DEP_MANAGER         // Department manager - approves/reviews
  SAFETY_MANAGER      // Safety Manager - escalation target, full control
  HR_REP              // HR representative - GOSI handling
  SERVICE_PROVIDER_REP // Contractor company representative
  FINANCE_REP         // Finance department representative

  // Legacy roles kept for compatibility
  SPORT_MARSHAL
  OC_SUPERVISOR
  OC_SAFETY_INVESTIGATOR
  OC_HSE_MANAGER
  VIEWER
}

enum TicketType {
  OBSERVATION
  ACCIDENT
  SECURITY
  VIOLATION
  NEAR_MISS
  INJURY
  HEALTH
  PROPERTY_DAMAGE
  SECURITY_BREACH
  OTHER
}

enum TicketStatus {
  SUBMITTED                // المبلّغ أرسل التقرير
  RETURNED_TO_REPORTER     // أُرجع للمبلّغ لتعديل
  ASSIGNED                 // وُجّه للقسم المعني لخطط العمل
  RETURNED_TO_DEPARTMENT   // أُرجع للقسم من المتحكم
  UNDER_REVIEW             // قيد المراجعة من المتحكم بعد رد القسم
  PENDING_REMINDER         // بانتظار التذكير
  ESCALATED                // مُصعّد لمدير السلامة
  CLOSED                   // مغلق
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  BANNED
}

enum ActionPlanType {
  IMMEDIATE    // فوري (مطلوب)
  SHORT_TERM   // قصير المدى (مطلوب)
  LONG_TERM    // طويل المدى (اختياري)
}

enum ActionPlanStatus {
  PENDING      // لم يُقدم بعد
  SUBMITTED    // تم التقديم
  APPROVED     // تمت الموافقة
  REJECTED     // مرفوض - يحتاج إعادة
}
